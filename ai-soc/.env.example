# Copy to .env and fill in. Do NOT commit .env (it's gitignored).

# --- Claude API ---
ANTHROPIC_API_KEY=sk-ant-...          # or run `ant auth login` instead of setting this
AISOC_MODEL=claude-opus-5             # override to claude-sonnet-5 / claude-haiku-4-5 if you want cheaper

# --- Wazuh indexer (only needed for `analyze.py --from-wazuh`) ---
WAZUH_URL=https://192.168.56.10:9200  # your Ubuntu VM's host-only IP, indexer port
WAZUH_USER=admin
WAZUH_PASS=SecretPassword             # change from the default
WAZUH_INDEX=wazuh-alerts-*
# WAZUH_CA_CERT=/path/to/root-ca.pem  # set to verify the self-signed indexer cert; unset = skip verify (isolated lab only)
