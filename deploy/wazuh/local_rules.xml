<!--
  DetectForge native Wazuh rules (Wazuh 4.14.x).
  Deploy via dashboard: ☰ → Server Management → Rules → Manage rules files → local_rules.xml
  → paste this whole file → Save → Restart manager.

  Anchoring: Sysmon rules chain on <if_group>sysmon</if_group> (confirmed present in this
  lab) + an explicit win.system.eventID match, so they fire regardless of ruleset-version
  group-name drift. Security-channel rules chain on <if_group>windows</if_group>.
  Rule id range 100200-100299 reserved for DetectForge. type="pcre2" for case-insensitive alternation.
-->
<group name="sysmon,attack,detectforge,">

  <!-- T1059.001 — PowerShell encoded command / download cradle. Sysmon EID 1. -->
  <rule id="100201" level="12">
    <if_group>sysmon</if_group>
    <field name="win.system.eventID">^1$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(powershell|pwsh)\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)-enc\b|-e\b|EncodedCommand|FromBase64String|IEX\b|Invoke-Expression|Net\.WebClient|DownloadString|DownloadFile|DownloadData</field>
    <description>PowerShell encoded command or download cradle (ATT&amp;CK T1059.001)</description>
    <mitre><id>T1059.001</id></mitre>
  </rule>
  <!-- FP tune-down (enable after benign pass): known-good caller drops severity.
  <rule id="100202" level="2">
    <if_sid>100201</if_sid>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)\\your-automation-agent\.exe$</field>
    <description>Benign automation PowerShell cradle (tuned down from T1059.001)</description>
  </rule>
  -->

  <!-- T1547.001 — Registry Run/RunOnce key write. Chains on Wazuh built-in 92302
       (sysmon EID13 Run-key detection) so our tagged rule fires instead of being
       suppressed by the built-in. Lesson: extend the shipped ruleset, don't duplicate it. -->
  <rule id="100211" level="10">
    <if_sid>92302</if_sid>
    <description>Registry Run key persistence (ATT&amp;CK T1547.001) [DetectForge]</description>
    <mitre><id>T1547.001</id></mitre>
  </rule>

  <!-- T1053.005 — Scheduled task creation. Sysmon EID 1. -->
  <rule id="100221" level="10">
    <if_group>sysmon</if_group>
    <field name="win.system.eventID">^1$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(schtasks|powershell|pwsh)\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)/create\b|Register-ScheduledTask|New-ScheduledTask</field>
    <description>Scheduled task created for persistence (ATT&amp;CK T1053.005)</description>
    <mitre><id>T1053.005</id></mitre>
  </rule>

  <!-- T1003.001 — LSASS memory access (credential dumping). Sysmon EID 10. MARQUEE. -->
  <rule id="100231" level="12">
    <if_group>sysmon</if_group>
    <field name="win.system.eventID">^10$</field>
    <field name="win.eventdata.targetImage" type="pcre2">(?i)\\lsass\.exe$</field>
    <field name="win.eventdata.grantedAccess" type="pcre2">(?i)^0x(1010|1410|1418|1438|143a|1fffff)$</field>
    <description>LSASS memory access consistent with credential dumping (ATT&amp;CK T1003.001)</description>
    <mitre><id>T1003.001</id></mitre>
  </rule>
  <!-- FP tune-down (enable after benign pass): AV/EDR/agent legitimately reads LSASS.
  <rule id="100232" level="2">
    <if_sid>100231</if_sid>
    <field name="win.eventdata.sourceImage" type="pcre2">(?i)\\(MsMpEng|wazuh-agent)\.exe$</field>
    <description>Benign LSASS read by AV/EDR (tuned down from T1003.001)</description>
  </rule>
  -->

  <!-- T1055 — Process injection via CreateRemoteThread. Sysmon EID 8. -->
  <rule id="100241" level="12">
    <if_group>sysmon</if_group>
    <field name="win.system.eventID">^8$</field>
    <field name="win.eventdata.targetImage" type="pcre2">(?i)\\(svchost|explorer|notepad|rundll32|lsass|werfault)\.exe$</field>
    <description>Remote thread created in another process (process injection, ATT&amp;CK T1055)</description>
    <mitre><id>T1055</id></mitre>
  </rule>

  <!-- T1070.001 — Clear event logs. (a) Sysmon EID 1 process vector. -->
  <rule id="100251" level="12">
    <if_group>sysmon</if_group>
    <field name="win.system.eventID">^1$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(wevtutil|powershell|pwsh)\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\bcl\b|clear-log|Clear-EventLog|Remove-EventLog|Clear-WinEvent</field>
    <description>Windows event log cleared via command line (ATT&amp;CK T1070.001)</description>
    <mitre><id>T1070.001</id></mitre>
  </rule>
  <!-- T1070.001 — (b) high-fidelity Security channel: EventID 1102 = audit log cleared. -->
  <rule id="100252" level="12">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^1102$</field>
    <description>Security audit log was cleared (ATT&amp;CK T1070.001, EventID 1102)</description>
    <mitre><id>T1070.001</id></mitre>
  </rule>

  <!-- T1136.001 — Create local account. (a) Sysmon EID 1 process vector. -->
  <rule id="100261" level="10">
    <if_group>sysmon</if_group>
    <field name="win.system.eventID">^1$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(net1?|powershell|pwsh)\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(user\s+.+\s+/add)|New-LocalUser</field>
    <description>Local account created via command line (ATT&amp;CK T1136.001)</description>
    <mitre><id>T1136.001</id></mitre>
  </rule>
  <!-- T1136.001 — (b) Security channel: EventID 4720 = a user account was created. -->
  <rule id="100262" level="10">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^4720$</field>
    <description>A local user account was created (ATT&amp;CK T1136.001, EventID 4720)</description>
    <mitre><id>T1136.001</id></mitre>
  </rule>

  <!-- T1105 — Ingress tool transfer via LOLBin downloaders. Sysmon EID 1. -->
  <rule id="100271" level="10">
    <if_group>sysmon</if_group>
    <field name="win.system.eventID">^1$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(certutil|bitsadmin|curl|wget|powershell|pwsh)\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)urlcache|/transfer\b|DownloadFile|Invoke-WebRequest|\biwr\b|Start-BitsTransfer|https?://</field>
    <description>Remote file download via LOLBin (ingress tool transfer, ATT&amp;CK T1105)</description>
    <mitre><id>T1105</id></mitre>
  </rule>

  <!-- T1021.001 — Remote Desktop logon. Security channel EventID 4624, LogonType 10. -->
  <rule id="100281" level="5">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^4624$</field>
    <field name="win.eventdata.logonType">^10$</field>
    <description>Successful RDP (RemoteInteractive) logon (ATT&amp;CK T1021.001)</description>
    <mitre><id>T1021.001</id></mitre>
  </rule>

  <!-- T1048/T1567 — Scripted outbound to external host (heuristic exfil). Sysmon EID 3. -->
  <rule id="100291" level="6">
    <if_group>sysmon</if_group>
    <field name="win.system.eventID">^3$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(powershell|pwsh|curl|nslookup|certutil|bitsadmin)\.exe$</field>
    <field name="win.eventdata.initiated">^true$</field>
    <description>Script/LOLBin initiated an outbound connection (possible exfiltration, ATT&amp;CK T1048/T1567)</description>
    <mitre><id>T1048</id><id>T1567</id></mitre>
  </rule>
  <!-- Tune-down: destination is a private/internal address → almost always benign. -->
  <rule id="100292" level="2">
    <if_sid>100291</if_sid>
    <field name="win.eventdata.destinationIp" type="pcre2">^(10\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[01])\.|127\.|169\.254\.|::1|fe80:)</field>
    <description>Scripted outbound to internal address (tuned down from T1048/T1567)</description>
  </rule>

</group>
